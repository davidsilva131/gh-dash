---
import Layout from "../layouts/Layout.astro";
import DashboardIsland from "../components/DashboardIsland";
---

<Layout title="gh-dash — GitHub Dashboard">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-primary">gh-dash</h1>
      <p class="text-muted mt-1">GitHub Personal Dashboard</p>
    </header>
    
    <section class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Try it out</h2>
      <DashboardIsland client:load />
    </section>
    
    <footer class="text-center text-sm text-muted border-t border-border pt-6 mt-12">
      <p>Built with Astro + React + Tailwind v4 + shadcn/ui</p>
    </footer>
  </main>
</Layout>
