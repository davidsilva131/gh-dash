---
import "../styles/global.css";

export interface Props {
  title?: string;
}

const { title = "gh-dash" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <slot />
  </body>
</html>
